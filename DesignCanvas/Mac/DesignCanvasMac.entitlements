<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  No App Sandbox: the app dials iPads through usbmuxd's socket and launches Claude Code.
	  The one entitlement asks Terminal.app to run the Claude Code launch command via
	  AppleScript.
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
